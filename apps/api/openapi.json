{
  "openapi": "3.1.0",
  "info": {
    "title": "School Platform API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleClaim"
            }
          }
        },
        "required": [
          "user",
          "roles"
        ]
      },
      "SessionUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "fullName",
          "email"
        ]
      },
      "RoleClaim": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "own",
              "assigned",
              "section",
              "institution"
            ]
          },
          "section": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "scope"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "SignInBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PublicConfig": {
        "type": "object",
        "properties": {
          "school": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "shortName": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "template": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "shortName",
              "currency",
              "timezone",
              "region",
              "template"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "name"
              ]
            }
          },
          "modules": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "terms": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "theme": {
            "$ref": "#/components/schemas/Theme"
          }
        },
        "required": [
          "school",
          "sections",
          "modules",
          "terms",
          "theme"
        ]
      },
      "Theme": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "font": {
            "type": "string",
            "enum": [
              "system",
              "inter",
              "noto-sans"
            ]
          },
          "shape": {
            "type": "object",
            "properties": {
              "radiusCard": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "radiusControl": {
                "type": "integer",
                "minimum": 0,
                "maximum": 24
              }
            },
            "required": [
              "radiusCard",
              "radiusControl"
            ],
            "additionalProperties": false
          },
          "light": {
            "type": "object",
            "properties": {
              "background": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "surface": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "text": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "textMuted": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "border": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "primary": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "primaryText": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "ok": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "okSoft": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "bad": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "badSoft": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              }
            },
            "required": [
              "background",
              "surface",
              "text",
              "textMuted",
              "border",
              "primary",
              "primaryText",
              "ok",
              "okSoft",
              "bad",
              "badSoft"
            ],
            "additionalProperties": false
          },
          "dark": {
            "type": "object",
            "properties": {
              "background": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "surface": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "text": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "textMuted": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "border": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "primary": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "primaryText": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "ok": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "okSoft": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "bad": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              "badSoft": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              }
            },
            "required": [
              "background",
              "surface",
              "text",
              "textMuted",
              "border",
              "primary",
              "primaryText",
              "ok",
              "okSoft",
              "bad",
              "badSoft"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "font",
          "shape",
          "light"
        ],
        "additionalProperties": false
      },
      "ConfigError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_check",
        "tags": [
          "health"
        ],
        "description": "Liveness and database check for uptime monitoring. Reveals nothing else.",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in": {
      "post": {
        "operationId": "sign_in",
        "tags": [
          "auth"
        ],
        "description": "Sign in with email and password. Sets the session cookies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password. The same answer for an unknown email.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too many recent failed attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "refresh_session",
        "tags": [
          "auth"
        ],
        "description": "Swaps the refresh cookie for a new pair of cookies.",
        "responses": {
          "200": {
            "description": "Refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "No valid session. `refresh_in_progress` means retry once.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "operationId": "sign_out",
        "tags": [
          "auth"
        ],
        "description": "Ends the session and clears the cookies. Always succeeds.",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "current_session",
        "tags": [
          "auth"
        ],
        "description": "Who is signed in, from the signed access cookie. No database read.",
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RoleClaim"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "roles"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access cookie expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/config/public": {
      "get": {
        "operationId": "public_config",
        "tags": [
          "config"
        ],
        "description": "What the web app needs to draw itself for this school: name, sections, wording, modules, theme.",
        "responses": {
          "200": {
            "description": "The school's configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          },
          "503": {
            "description": "This school has not been set up yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigError"
                }
              }
            }
          }
        }
      }
    },
    "/api/config/theme": {
      "put": {
        "operationId": "save_theme",
        "tags": [
          "config"
        ],
        "description": "Replaces the school's theme. Refused unless every colour pair passes the readability check.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Theme"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved and active",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "theme": {
                      "$ref": "#/components/schemas/Theme"
                    }
                  },
                  "required": [
                    "theme"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "The theme is not readable. Nothing was saved.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "contrast_check_failed"
                      ]
                    },
                    "failures": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "enum": [
                              "light",
                              "dark"
                            ]
                          },
                          "rule": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "ratio": {
                            "type": "number"
                          },
                          "minimum": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "mode",
                          "rule",
                          "label",
                          "ratio",
                          "minimum"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error",
                    "failures"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
