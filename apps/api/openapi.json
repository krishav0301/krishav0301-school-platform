{
  "openapi": "3.1.0",
  "info": {
    "title": "School Platform API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleClaim"
            }
          }
        },
        "required": [
          "user",
          "roles"
        ]
      },
      "SessionUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "fullName",
          "email"
        ]
      },
      "RoleClaim": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "own",
              "assigned",
              "section",
              "institution"
            ]
          },
          "section": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "scope"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "SignInBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_check",
        "tags": [
          "health"
        ],
        "description": "Liveness and database check for uptime monitoring. Reveals nothing else.",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in": {
      "post": {
        "operationId": "sign_in",
        "tags": [
          "auth"
        ],
        "description": "Sign in with email and password. Sets the session cookies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password. The same answer for an unknown email.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too many recent failed attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "refresh_session",
        "tags": [
          "auth"
        ],
        "description": "Swaps the refresh cookie for a new pair of cookies.",
        "responses": {
          "200": {
            "description": "Refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "No valid session. `refresh_in_progress` means retry once.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "operationId": "sign_out",
        "tags": [
          "auth"
        ],
        "description": "Ends the session and clears the cookies. Always succeeds.",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "current_session",
        "tags": [
          "auth"
        ],
        "description": "Who is signed in, from the signed access cookie. No database read.",
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RoleClaim"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "roles"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access cookie expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
