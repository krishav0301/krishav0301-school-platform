{
  // Used only by the test runner. No static assets, so tests do not depend on the web build.
  "name": "school-platform-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "test",
    "DEMO_MODE": "false",
    // Test-only value. Real deployments set this as a secret, never in a file.
    "AUDIT_HMAC_KEY": "test-only-audit-key-0123456789abcdef0123456789abcdef",
    "SESSION_SECRET": "test-only-session-secret-0123456789abcdef0123456789abcdef"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school_test",
      "database_id": "00000000-0000-0000-0000-000000000001"
    },
    {
      // A second database for tests that deliberately tamper with the audit log.
      "binding": "SCRATCH_DB",
      "database_name": "school_scratch",
      "database_id": "00000000-0000-0000-0000-000000000002"
    }
  ]
}
