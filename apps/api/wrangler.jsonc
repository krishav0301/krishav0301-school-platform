{
  // One Worker per school deployment. It serves the static web app and the API on one origin.
  // Per-school ids (account, database) belong in a local, git-ignored override; see README.
  "name": "school-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "DEMO_MODE": "true",
    "EMAIL_ADAPTER": "dev"
  },
  // The retry sweep for the outbox. Requests deliver what they queue at once; this catches the rest.
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/notices"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school_dev",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
